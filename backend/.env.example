# =============================================================================
#  Jakeala Naturals - backend environment
#  Copy this file to  backend/.env  and edit the values.
#  (backend/.env is gitignored - never commit real secrets.)
# =============================================================================

# --- Core -------------------------------------------------------------------
# 1 = development (DEBUG on, CORS open), 0 = production
DJANGO_DEBUG=1

# Secret key. REQUIRED when DJANGO_DEBUG=0 - the app refuses to boot without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-jakeala-naturals-change-in-production

# Hostnames Django answers for (no scheme, no slashes). Add your live domain.
ALLOWED_HOSTS=localhost,127.0.0.1

# Front-end origins allowed to call the API (scheme included, no trailing slash).
# Leave empty in development; all origins are allowed while DJANGO_DEBUG=1.
# Example: https://jakeala.com,https://www.jakeala.com
CORS_ALLOWED_ORIGINS=

# Regexes for origins too dynamic to list - Vercel gives every preview deployment
# its own hostname. Example:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://jakeala-naturals[a-z0-9-]*\.vercel\.app$

# Origins Django trusts for unsafe POSTs (Django admin login). Needs the full
# scheme://host of the API itself.
# Example: https://<your-username>.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Where the storefront lives - used in email links and as the Paystack default
# callback. Example: https://jakeala.com
SITE_URL=http://localhost:3000
# Public URL of the API itself.
API_BASE_URL=http://localhost:8000

# --- Security toggles (production) ------------------------------------------
# Set to 0 to test over plain HTTP.
# DJANGO_SECURE_COOKIES=1
# Force every request onto HTTPS. Safe on PythonAnywhere (it terminates TLS).
# DJANGO_SECURE_SSL_REDIRECT=0
# Remember HTTPS in the browser for a year. Enable only once the domain is final.
# DJANGO_HSTS=0
# How long an API token stays valid before the user must sign in again.
# AUTH_TOKEN_TTL_DAYS=30
# Most of one product that may sit in a basket.
# CART_MAX_QUANTITY=99

# --- Transactional email: EmailJS (https://dashboard.emailjs.com) -----------
# PythonAnywhere's free plan blocks outbound SMTP, so mail goes over HTTPS.
# Server-side sends need the PRIVATE key. It must never reach the browser, which
# is exactly why verification codes are generated by the API, not the front end.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Template ids from the EmailJS dashboard. Reset falls back to the verify
# template when left empty.
EMAILJS_TEMPLATE_VERIFY=
EMAILJS_TEMPLATE_RESET=
EMAILJS_TEMPLATE_ORDER=
# VERIFICATION_CODE_TTL_MINUTES=15
# VERIFICATION_MAX_ATTEMPTS=5

# --- Payments: Paystack (https://dashboard.paystack.com/#/settings/developers)
# Test keys (sk_test_... / pk_test_...) work end to end with Paystack test cards.
# Swap in the live keys when you are ready to take real money.
# Both are required before the checkout can take a card.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_CURRENCY=NGN
# PAYSTACK_CALLBACK_URL=https://jakeala.com/payment/verify

# Delivery pricing, in naira.
# FREE_SHIPPING_THRESHOLD=15000
# FLAT_SHIPPING_FEE=2500

# --- Seed data (python manage.py seed) --------------------------------------
# The fallback admin password is published in this repository - set your own
# before going live. The seeder never overwrites a password you have changed.
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=info@jakeala.com
# DJANGO_ADMIN_PASSWORD=
