# =============================================================================
#  Jakeala Naturals - backend environment
#  Copy this file to  backend/.env  and edit the values.
#  (backend/.env is gitignored - never commit real secrets.)
# =============================================================================

# --- Local development -------------------------------------------------------
# These are the defaults you want while running `manage.py runserver`.
# DJANGO_SECRET_KEY=dev-jakeala-naturals-change-in-production
# DJANGO_DEBUG=1
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=

# --- Production (PythonAnywhere) --------------------------------------------
# Start from the values below, then follow DEPLOYMENT.md.

# 1 = development (DEBUG on, CORS wide open), 0 = production
DJANGO_DEBUG=1

# Secret key. REQUIRED when DJANGO_DEBUG=0 - the app refuses to boot without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-jakeala-naturals-change-in-production

# Comma-separated hostnames Django will answer for (no scheme, no slashes).
# Include your PythonAnywhere domain and any custom API domain.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated front-end origins allowed to call the API (with scheme).
# Leave empty in development (all origins are allowed while DJANGO_DEBUG=1).
# Example: https://jakeala.com,https://www.jakeala.com
CORS_ALLOWED_ORIGINS=

# Origins Django trusts for unsafe POSTs (the Django admin login). Needs the
# full scheme://host of the API itself.
# Example: https://<your-username>.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Set to 0 if you need to test over plain HTTP (otherwise secure cookies are
# forced on in production).
# DJANGO_SECURE_COOKIES=1

# Set to 1 to force every request onto HTTPS. Safe on PythonAnywhere, which
# terminates TLS for you - enable it once the site is confirmed working.
# DJANGO_SECURE_SSL_REDIRECT=0
