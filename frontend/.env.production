# =============================================================================
#  Production build settings (committed on purpose)
# -----------------------------------------------------------------------------
#  Next.js loads this file automatically for `next build`, which is exactly what
#  Vercel runs - so these values are applied without touching the Vercel
#  dashboard. A variable set in the Vercel UI still wins, because Vercel injects
#  its values into the build environment before Next.js reads these files.
#
#  Why commit an env file? Every NEXT_PUBLIC_* value is PUBLIC by design - it is
#  embedded in the JavaScript shipped to the browser, so it is not a secret.
#  Never put a private key (Stripe secret, Django SECRET_KEY, ...) in here.
#
#  NOTE: this file is NOT used by `npm run dev`. Local development reads
#  .env.local instead, so your dev server keeps talking to localhost.
# =============================================================================

# The live Django API on PythonAnywhere.
NEXT_PUBLIC_API_URL=https://jakealanaturals.pythonanywhere.com/api

# Public site URL for canonical links, sitemap.xml, robots.txt and JSON-LD.
# Change this if the site ends up on a different domain.
NEXT_PUBLIC_SITE_URL=https://jakeala.com

# Public contact address shown in legal/policy copy.
NEXT_PUBLIC_SITE_EMAIL=info@jakeala.com
