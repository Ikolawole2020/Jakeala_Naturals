# URL of the Django API. Local dev default:
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public URL of THIS front end. Used for canonical links, sitemap.xml,
# robots.txt and JSON-LD. Set it to your live domain in production, e.g.
#   NEXT_PUBLIC_SITE_URL=https://jakeala.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown in legal/policy copy.
NEXT_PUBLIC_SITE_EMAIL=info@jakeala.com
